{
  "name": "@esigenta/taxonomy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./frozen": "./src/frozen/index.ts",
    "./public-professions": "./src/public-professions.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/frozen/publication-status.test.ts src/frozen/list-company-professions.test.ts src/frozen/list-public-professions.test.ts src/frozen/list-public-professions-for-project-group.test.ts src/frozen/resolve-profession-interventions.test.ts src/frozen/orchestrator/sync-catalog-to-database.test.ts src/public-professions.test.ts",
    "test:lifecycle-db": "node --import tsx --test src/queries/publication-lifecycle.integration.test.ts",
    "taxonomy:frozen:build": "tsx src/frozen/orchestrator/build-taxonomy.ts",
    "taxonomy:frozen:generate": "tsx src/frozen/orchestrator/generate-taxonomy.ts",
    "taxonomy:frozen:sync-db": "tsx src/frozen/orchestrator/sync-catalog-to-database.ts"
  },
  "dependencies": {
    "@esigenta/database": "workspace:*",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "tsx": "^4.21.0"
  }
}
